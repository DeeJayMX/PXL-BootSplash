# pxl-bootsplash — le thème Plymouth « pxl » (module « script »), commun à tous les appareils PXL.
# Repris de la box PXL GFX (PXL-Kiosk-RK3566, installation/fichiers/plymouth-pxl/pxl.script, 02/10/2026) : grand logo
# centré, puis les étapes du démarrage. Ce qui change : les étapes ne sont plus écrites ici — c'est l'APPAREIL qui les
# déclare (/etc/pxl-bootsplash/appareil.conf), et le moteur (pxl-bootsplash-etapes) les envoie.
# ⭐ 1.1.0 (30/10, demande d'Eliott) : une BARRE DE CHARGEMENT dans un cartouche à bords arrondis, en bas (1.1.2 : le
# cartouche n'entoure plus que la barre) ;
# la barre se remplit d'une « rivière de QR code » en pixels (theme/riviere.svg) qui défile en continu et suit le
# chargement. Le même écran sert À L'ARRÊT (Plymouth.GetMode() ≠ "boot") avec les étapes d'arrêt.
#
# Tout arrive par `plymouth update --status="pxl|K|S|texte"` :
#   K = 1 à 8 : une étape · F : le pied de page · B : l'avancement donné par le moteur (S = 0-9A-Z, 0 → 35)
#   S = n : « texte » est le LIBELLÉ de l'étape (envoyé une fois, au départ) — l'étape devient visible
#       0 en attente · 1 en cours · 2 fait · 3 en défaut · 4 avertissement : « texte » est le DÉTAIL
# Le langage de script de Plymouth n'a ni découpage de chaîne ni conversion sûre nombre ↔ texte (box, 02/10) : le
# format est FIXE (K en position 4, S en 6, texte à partir de 8), et nombres ↔ textes passent par des TABLES.
# Les autres messages de mise à jour sont ceux de systemd (nom de l'unité) : détail de l'étape 1 tant qu'elle n'est pas faite.
# ⚠️ Tout est à l'échelle de la HAUTEUR (k = H / 1080) : un mur LED en 1536x768, un moniteur 1080p et un 7" en 800x480
# montrent la même page. Les images sont rendues à l'installation pour les hauteurs courantes (nom-HAUTEUR.png, pixels
# francs) ; une autre hauteur reprend celles de 1080 mises à l'échelle.

W = Window.GetWidth(); H = Window.GetHeight();
Window.SetBackgroundTopColor(0.043, 0.051, 0.071);
Window.SetBackgroundBottomColor(0.027, 0.031, 0.043);
k = H / 1080;
fun police(taille, gras) { if (gras) return "DejaVu Sans Bold " + Math.Int(taille * k); return "DejaVu Sans " + Math.Int(taille * k); }
arret = 0;
if (Plymouth.GetMode() != "boot") arret = 1;

# ---- les images à la taille de l'écran : une TABLE de hauteurs (pas de conversion nombre → texte)
suffixe = "1080";
if (H == 480) suffixe = "480"; else if (H == 600) suffixe = "600"; else if (H == 720) suffixe = "720";
else if (H == 768) suffixe = "768"; else if (H == 800) suffixe = "800"; else if (H == 1024) suffixe = "1024";
else if (H == 1200) suffixe = "1200"; else if (H == 1440) suffixe = "1440"; else if (H == 2160) suffixe = "2160";
fun charger(nom) {
  img = Image(nom + "-" + suffixe + ".png");
  if (img) return img;
  img = Image(nom + "-1080.png");
  if (img) return img.Scale(img.GetWidth() * k, img.GetHeight() * k);
  return img;
}

# ---- logo, en grand, centré dans le haut de l'écran (rendu depuis logo-pxl.svg à l'installation)
logo = Image("logo.png");
if (logo) {
  lw = W * 0.34; lh = logo.GetHeight() * lw / logo.GetWidth();
  if (lh > H * 0.30) { lh = H * 0.30; lw = logo.GetWidth() * lh / logo.GetHeight(); }
  logo_sprite = Sprite(logo.Scale(lw, lh));
  logo_sprite.SetPosition(W / 2 - lw / 2, H * 0.24 - lh / 2, 1);
} else {
  logo_sprite = Sprite(Image.Text("pxl mstrs.", 1, 1, 1, 1, police(90, 1)));
  logo_sprite.SetPosition(W / 2 - logo_sprite.GetImage().GetWidth() / 2, H * 0.17, 1);
}

# ---- le cartouche : AUTOUR DE LA BARRE seulement (1.1.2 — les étapes sont à nu, comme sur la box)
cy = H * 0.455;
cartouche = charger("cartouche");
if (cartouche) {
  cartouche_sprite = Sprite(cartouche);
  cartouche_sprite.SetPosition(W / 2 - cartouche.GetWidth() / 2, cy + 324 * k, 1);
}

# ---- les étapes : 8 places, invisibles tant que l'appareil ne les a pas nommées
num["1"] = 1; num["2"] = 2; num["3"] = 3; num["4"] = 4; num["5"] = 5; num["6"] = 6; num["7"] = 7; num["8"] = 8;
x0 = W / 2 - 330 * k; y0 = cy + 34 * k; pas = 38 * k;
for (i = 1; i <= 8; i++) {
  nommee[i] = 0; etat[i] = "0"; detail[i] = "";
  icone[i] = Sprite(); icone[i].SetPosition(x0, y0 + (i - 1) * pas, 6);
  libelle[i] = Sprite(); libelle[i].SetPosition(x0 + 44 * k, y0 + (i - 1) * pas, 6);
  texte[i] = Sprite(); texte[i].SetPosition(x0 + 300 * k, y0 + (i - 1) * pas + 3 * k, 6);
}
pied = Sprite(); pied.SetPosition(W / 2, H * 0.94, 6);

fun dessiner(i) {
  if (!nommee[i]) return;
  s = etat[i];
  if (s == "2") img = Image.Text("✓", 0.18, 0.80, 0.50, 1, police(22, 1));          # fait : vert
  else if (s == "3") img = Image.Text("✕", 0.95, 0.30, 0.32, 1, police(22, 1));     # défaut : rouge
  else if (s == "4") img = Image.Text("!", 0.95, 0.65, 0.23, 1, police(22, 1));     # avertissement : orange
  else if (s == "1") img = Image.Text("●", 0.24, 0.78, 0.92, 1, police(20, 0));     # en cours : cyan, clignote
  else img = Image.Text("○", 0.45, 0.48, 0.55, 1, police(20, 0));                    # en attente : gris
  icone[i].SetImage(img);
  if (s == "3") c = 0.95; else c = 0.62;
  texte[i].SetImage(Image.Text(detail[i], c, c * 0.7 + 0.2, c * 0.7 + 0.25, 1, police(17, 0)));
}

# ---- la barre : piste (fond), rivière (le remplissage, recadré à chaque image), tête lumineuse, masque (coins + bord)
piste = charger("piste"); riviere = charger("riviere"); tete = charger("tete"); masque = charger("masque");
barre = 0;
if (piste && riviere && masque) barre = 1;
if (barre) {
  px = W / 2 - piste.GetWidth() / 2; py = cy + 368 * k;
  pl = piste.GetWidth(); rh = riviere.GetHeight(); ry = py + (piste.GetHeight() - rh) / 2;
  periode = riviere.GetWidth() / 2;                  # la texture porte deux périodes : tout recadrage < période tient
  piste_sprite = Sprite(piste); piste_sprite.SetPosition(px, py, 2);
  remplissage = Sprite(); remplissage.SetPosition(px, ry, 3);
  if (tete) { tete_sprite = Sprite(tete); tete_sprite.SetPosition(px, ry, 4); tete_sprite.SetOpacity(0); }
  masque_sprite = Sprite(masque); masque_sprite.SetPosition(px, py, 5);
  if (arret) titre = "Arrêt"; else titre = "Chargement";
  titre_sprite = Sprite(Image.Text(titre, 0.62, 0.65, 0.70, 1, police(16, 1)));
  titre_sprite.SetPosition(px + 6 * k, py - 30 * k, 6);
  pourcent = Sprite(); pourcent.SetPosition(px + pl, py - 30 * k, 6);
}
chiffre[0] = "0"; chiffre[1] = "1"; chiffre[2] = "2"; chiffre[3] = "3"; chiffre[4] = "4";
chiffre[5] = "5"; chiffre[6] = "6"; chiffre[7] = "7"; chiffre[8] = "8"; chiffre[9] = "9";
fun en_texte(n) {   # 0 ≤ n ≤ 100, entier → texte, par la table
  if (n >= 100) return "100";
  d = Math.Int(n / 10); u = Math.Int(n - d * 10);
  if (d == 0) return chiffre[u];
  return chiffre[d] + chiffre[u];
}
# l'avancement donné par le moteur (« pxl|B|c| ») : un caractère, 36 niveaux
niveaux = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ";
for (n = 0; n < 36; n++) niveau[niveaux.CharAt(n)] = n;

# L'AVANCEMENT : le plus grand de trois témoins, et il ne recule JAMAIS —
#   · les étapes (faite = 1, en cours = 0,4), · l'estimation de Plymouth (la durée du démarrage précédent),
#   · celle du moteur (à l'arrêt : les services arrêtés).
cible = 0; vu = 0; p_temps = 0; p_moteur = 0; dernier_pc = -1;
fun recalculer() {
  somme = 0; n = 0;
  for (i = 1; i <= 8; i++) {
    if (nommee[i]) {
      n++;
      if (etat[i] == "2" || etat[i] == "3" || etat[i] == "4") somme += 1;
      else if (etat[i] == "1") somme += 0.4;
    }
  }
  c = 0;
  if (n > 0) c = somme / n;
  c = Math.Max(c, Math.Max(p_temps, p_moteur));
  if (c > 1) c = 1;
  if (c > cible) cible = c;
}
fun progression(duree, progres) { p_temps = progres; recalculer(); }
Plymouth.SetBootProgressFunction(progression);

fun a_jour(status) {
  if (status.SubString(0, 4) == "pxl|") {
    K = status.CharAt(4); S = status.CharAt(6); D = status.SubString(8, 400);
    if (K == "F") {
      img = Image.Text(D, 0.45, 0.48, 0.55, 1, police(15, 0));
      pied.SetImage(img); pied.SetX(W / 2 - img.GetWidth() / 2);
      return;
    }
    if (K == "B") { p_moteur = niveau[S] / 35; recalculer(); return; }
    i = num[K];   # pas de conversion nombre → texte sûre dans ce langage : une table
    if (!i) return;
    if (S == "n") {
      nommee[i] = 1;
      libelle[i].SetImage(Image.Text(D, 0.92, 0.93, 0.95, 1, police(21, 1)));
    } else { etat[i] = S; detail[i] = D; }
    dessiner(i);
    recalculer();
  } else if (etat[1] != "2") {
    # message de systemd : l'unité qui démarre, en détail de l'étape 1
    etat[1] = "1"; detail[1] = status; dessiner(1);
  }
}
Plymouth.SetUpdateStatusFunction(a_jour);

# ---- à chaque image : clignotement des étapes en cours, la barre qui rejoint sa cible, la rivière qui coule
t = 0; decalage = 0;
fun rafraichir() {
  t++;
  o = 0.35 + 0.65 * Math.Abs(Math.Sin(t / 18));
  for (i = 1; i <= 8; i++) { if (etat[i] == "1") icone[i].SetOpacity(o); else icone[i].SetOpacity(1); }
  if (!barre) return;
  vu = vu + (cible - vu) * 0.06;                       # rejoint la cible en douceur (~1 s)
  if (cible - vu < 0.001) vu = cible;
  lf = Math.Int(vu * pl);
  decalage = decalage + 1.6 * k;                      # le courant, à ~80 px/s en 1080 — À CONTRE-SENS du remplissage
                                                      # (Eliott, 30/10 : « dans le sens inverse du remplissage »)
  if (decalage >= periode) decalage = decalage - periode;
  if (lf >= 2) {
    remplissage.SetImage(riviere.Crop(Math.Int(decalage), 0, lf, rh));   # fenêtre qui avance ⇒ texture qui recule
    remplissage.SetOpacity(1);
    if (tete) { tete_sprite.SetX(px + lf - tete.GetWidth()); tete_sprite.SetOpacity(0.55 + 0.45 * o); }
  } else {
    remplissage.SetOpacity(0);
  }
  pc = Math.Int(vu * 100 + 0.5);
  if (pc != dernier_pc) {
    dernier_pc = pc;
    img = Image.Text(en_texte(pc) + " %", 0.62, 0.65, 0.70, 1, police(16, 1));
    pourcent.SetImage(img); pourcent.SetX(px + pl - img.GetWidth() - 6 * k);
  }
}
Plymouth.SetRefreshFunction(rafraichir);

# les messages de Plymouth lui-même (mot de passe, erreur) : en pied de page, pour ne jamais rester invisibles
fun message(texte_) { a_jour("pxl|F|0|" + texte_); }
Plymouth.SetDisplayMessageFunction(message);
